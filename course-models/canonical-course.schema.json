{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uido.golf/schemas/canonical-course.v2.json",
  "title": "UiDo Canonical Course Source of Truth v2",
  "type": "object",
  "required": ["schema", "course", "provenance", "geometry", "holes", "validation"],
  "properties": {
    "schema": {"const": "uido.course.canonical.v2"},
    "course": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "location": {"type": "object"}}
    },
    "provenance": {
      "type": "object",
      "required": ["policy", "sources", "upstream_model_schema"],
      "properties": {
        "policy": {"type": "string"},
        "upstream_model_schema": {"type": "string"},
        "sources": {"type": "array", "items": {"type": "object"}}
      }
    },
    "geometry": {
      "type": "object",
      "required": ["scope", "features"],
      "properties": {
        "scope": {"const": "course"},
        "features": {
          "type": "array",
          "items": {"$ref": "#/$defs/physicalFeature"}
        }
      }
    },
    "holes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 18,
      "items": {
        "type": "object",
        "required": ["hole_number", "routing", "truth"],
        "properties": {
          "hole_number": {"type": "integer", "minimum": 1, "maximum": 18},
          "par": {"type": ["integer", "null"]},
          "routing": {"type": ["object", "null"]},
          "truth": {"type": "string", "enum": ["CONFIRMED", "INCOMPLETE", "CONFLICT"]}
        },
        "additionalProperties": false
      }
    },
    "validation": {
      "type": "object",
      "required": ["course_complete", "holes_complete", "physical_geometry_count", "unique_physical_ids", "unresolved_features", "conflicts"],
      "properties": {
        "course_complete": {"type": "boolean"},
        "holes_complete": {"type": "integer"},
        "physical_geometry_count": {"type": "integer"},
        "unique_physical_ids": {"type": "integer"},
        "unresolved_features": {"type": "array"},
        "conflicts": {"type": "array"}
      }
    }
  },
  "$defs": {
    "physicalFeature": {
      "type": "object",
      "required": ["id", "type", "geometry"],
      "properties": {
        "id": {"type": "string"},
        "type": {"type": "string"},
        "geometry": {"type": "object"},
        "provenance": {},
        "confidence": {},
        "status": {},
        "source_refs": {"type": "array"},
        "association_evidence": {"type": "array"}
      },
      "additionalProperties": true
    }
  }
}
