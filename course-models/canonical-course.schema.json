{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uido.golf/schemas/canonical-course.v2.json",
  "title": "UiDo Canonical Course Source of Truth v2",
  "type": "object",
  "required": ["schema", "course", "provenance", "geometry", "holes", "validation"],
  "properties": {
    "schema": {"const": "uido.course.canonical.v2"},
    "course": {"type": "object", "required": ["id", "name"]},
    "provenance": {
      "type": "object",
      "required": ["policy", "sources"],
      "properties": {
        "policy": {"type": "string"},
        "sources": {"type": "array", "items": {"type": "object"}}
      }
    },
    "geometry": {
      "type": "object",
      "required": ["scope", "features"],
      "properties": {
        "scope": {"const": "course"},
        "features": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "type", "geometry"],
            "properties": {
              "id": {"type": "string"},
              "type": {"type": "string"},
              "geometry": {"type": "object"},
              "source_ids": {"type": "array", "items": {"type": "string"}},
              "association_evidence": {}
            }
          }
        }
      }
    },
    "holes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 18,
      "items": {
        "type": "object",
        "required": ["hole_number", "routing", "truth"],
        "properties": {
          "hole_number": {"type": "integer", "minimum": 1, "maximum": 18},
          "par": {"type": ["integer", "null"]},
          "truth": {"type": "string", "enum": ["CONFIRMED", "INCOMPLETE", "CONFLICT"]},
          "routing": {"type": "object"},
          "conflicts": {"type": "array"}
        }
      }
    },
    "validation": {
      "type": "object",
      "required": [
        "course_complete",
        "holes_complete",
        "physical_geometry_count",
        "unique_physical_geometry_ids",
        "unresolved_features",
        "conflicts"
      ]
    }
  }
}
