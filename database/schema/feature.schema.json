{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uido.golf/schema/feature.schema.json",
  "title": "UiDo Feature",
  "type": "object",
  "required": ["feature_id", "hole_id", "feature_type", "geometry", "confidence", "verification_status"],
  "properties": {
    "feature_id": {"type": "string"},
    "hole_id": {"type": "string"},
    "feature_type": {
      "type": "string",
      "enum": [
        "teeing_area",
        "fairway",
        "rough",
        "bunker",
        "water",
        "trees",
        "out_of_bounds",
        "green",
        "green_front",
        "green_back",
        "target",
        "carry_area",
        "layup_area"
      ]
    },
    "geometry": {
      "type": "object",
      "description": "GeoJSON geometry. Polygon/LineString/Point as appropriate for the feature."
    },
    "geometry_version": {"type": "integer", "minimum": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "verification_status": {
      "type": "string",
      "enum": ["unverified", "supported", "verified", "disputed"]
    },
    "evidence_ids": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": false
}
